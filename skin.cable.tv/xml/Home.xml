<?xml version="1.0" encoding="UTF-8"?>
<!--
	Cable TV home screen.

	A top bar, then a vertical grouplist of horizontal card rows. Estuary's home
	was a 462px sidemenu plus eight per-category widget stacks gated on the
	sidemenu selection; none of that survives, because a leanback launcher has
	no sidebar.

	The whole layout rests on the pin-to-top arithmetic documented in
	Constants_1080.xml: every row wrapper is exactly as tall as the grouplist,
	and the item gap is negative by (viewport minus pitch). Read that comment
	before changing any geometry here.

	Navigation is almost entirely implicit. The grouplist auto-wires up/down
	between its children (GUIControlGroupList::AddControl), each row's fixedlist
	declares onup/ondown at the NEIGHBOURING WRAPPER's id, and CGUIWindow::OnMove
	walks the chain through hidden or non-focusable controls until it finds
	something focusable. So turning a row off from skin settings needs no
	conditional navigation XML at all: the chain heals itself and the pitch
	arithmetic stays exact.

	Row ids are wrapper/list pairs 100 apart: wrapper 9110 owns list 9111, and so
	on. onup/ondown reference WRAPPERS, never lists.
-->
<window>
	<!--
		Points at the grouplist, not at a row's list. On a library with no movies
		and no TV shows the first row is invisible, and a defaultcontrol naming
		an unfocusable control can leave the window with nothing focused at all.
		Focusing a container delegates to its first focusable child, so this
		degrades correctly however many rows are hidden.
	-->
	<defaultcontrol>9100</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>

		<!-- 1. Base surface. One tinted pixel stretched: no image decode at
		     startup, which is worth having on a Fire Stick. -->
		<control type="image">
			<depth>DepthBackground</depth>
			<include>FullScreenDimensions</include>
			<aspectratio>stretch</aspectratio>
			<texture colordiffuse="background">colors/white.png</texture>
		</control>

		<!-- 2. Content backdrop. Kodi 22 has no blur available to skins, so the
		     frosted effect is a heavy dim plus the two scrims below. -->
		<control type="image">
			<depth>DepthBackground</depth>
			<include>FullScreenDimensions</include>
			<aspectratio>scale</aspectratio>
			<fadetime>400</fadetime>
			<texture background="true" colordiffuse="$VAR[LeanBackdropTintVar]">$VAR[LeanBackdropVar]</texture>
			<visible>!String.IsEqual(Skin.String(backdrop_mode),off) + !Player.HasMedia</visible>
			<animation effect="fade" time="400">VisibleChange</animation>
		</control>

		<!-- 3. Scrims. One 8x512 gradient used twice, flipped for the bottom, so
		     two quads and 200 bytes of texture for the whole effect. -->
		<control type="image">
			<depth>DepthBackground</depth>
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>420</height>
			<aspectratio>stretch</aspectratio>
			<texture colordiffuse="scrim_strong">cable/scrims/vgrad.png</texture>
		</control>
		<control type="image">
			<depth>DepthBackground</depth>
			<left>0</left>
			<bottom>0</bottom>
			<width>100%</width>
			<height>720</height>
			<aspectratio>stretch</aspectratio>
			<texture flipy="true" colordiffuse="scrim_strong">cable/scrims/vgrad.png</texture>
		</control>

		<!-- 4. Top bar -->
		<include>LeanTopBar</include>

		<!-- 5. The rows -->
		<control type="grouplist" id="9100">
			<left>0</left>
			<top>lb_rowtop</top>
			<right>0</right>
			<bottom>0</bottom>
			<orientation>vertical</orientation>
			<itemgap>lb_rowgap</itemgap>
			<scrolltime tween="cubic" easing="out">200</scrolltime>

			<include content="LeanRow">
				<param name="group_id" value="9110" />
				<param name="list_id" value="9111" />
				<param name="prev_row" value="8000" />
				<param name="next_row" value="9120" />
				<param name="label" value="$LOCALIZE[31700]" />
				<param name="path" value="special://skin/playlists/inprogress_movies.xsp" />
				<param name="path2" value="special://skin/playlists/inprogress_episodes.xsp" />
				<param name="sortby" value="lastplayed" />
				<param name="visible" value="[Library.HasContent(movies) | Library.HasContent(tvshows)] + !Skin.HasSetting(no_row_continue)" />
			</include>

			<include content="LeanRow">
				<param name="group_id" value="9120" />
				<param name="list_id" value="9121" />
				<param name="prev_row" value="9110" />
				<param name="next_row" value="9130" />
				<param name="label" value="$LOCALIZE[31701]" />
				<param name="path" value="special://skin/playlists/recent_unwatched_movies.xsp" />
				<param name="sortby" value="dateadded" />
				<param name="visible" value="Library.HasContent(movies) + !Skin.HasSetting(no_row_recentmovies)" />
			</include>

			<include content="LeanRow">
				<param name="group_id" value="9130" />
				<param name="list_id" value="9131" />
				<param name="prev_row" value="9120" />
				<param name="next_row" value="9140" />
				<param name="label" value="$LOCALIZE[31702]" />
				<param name="path" value="special://skin/playlists/recent_unwatched_episodes.xsp" />
				<param name="sortby" value="dateadded" />
				<param name="visible" value="Library.HasContent(tvshows) + !Skin.HasSetting(no_row_recentepisodes)" />
			</include>

			<include content="LeanRow">
				<param name="group_id" value="9140" />
				<param name="list_id" value="9141" />
				<param name="prev_row" value="9130" />
				<param name="next_row" value="9150" />
				<param name="label" value="$LOCALIZE[31704]" />
				<param name="path" value="videodb://inprogresstvshows/" />
				<param name="sortby" value="lastplayed" />
				<param name="visible" value="Library.HasContent(tvshows) + !Skin.HasSetting(no_row_inprogresstv)" />
			</include>

			<include content="LeanRow">
				<param name="group_id" value="9150" />
				<param name="list_id" value="9151" />
				<param name="prev_row" value="9140" />
				<param name="next_row" value="9160" />
				<param name="label" value="$LOCALIZE[31703]" />
				<param name="path" value="special://skin/playlists/random_movies.xsp" />
				<param name="visible" value="Library.HasContent(movies) + !Skin.HasSetting(no_row_randommovies)" />
			</include>

			<include content="LeanRow">
				<param name="group_id" value="9160" />
				<param name="list_id" value="9161" />
				<param name="prev_row" value="9150" />
				<param name="next_row" value="9170" />
				<param name="label" value="$LOCALIZE[31705]" />
				<param name="path" value="musicdb://recentlyaddedalbums/" />
				<param name="target" value="music" />
				<param name="card" value="LeanCardSquare" />
				<param name="pitch" value="lb_sqpitch" />
				<param name="visible" value="Library.HasContent(music) + !Skin.HasSetting(no_row_music)" />
			</include>

			<include content="LeanRow">
				<param name="group_id" value="9170" />
				<param name="list_id" value="9171" />
				<param name="prev_row" value="9160" />
				<param name="next_row" value="9180" />
				<param name="label" value="$LOCALIZE[31706]" />
				<param name="path" value="addons://sources/game/" />
				<param name="target" value="games" />
				<param name="visible" value="!Skin.HasSetting(no_row_games)" />
			</include>

			<!-- Static row, so it is always reachable even on an empty library.
			     Deliberately last and deliberately not conditional: it is the
			     escape hatch to the rest of Kodi. -->
			<include content="LeanRowStatic">
				<param name="group_id" value="9180" />
				<param name="list_id" value="9181" />
				<param name="prev_row" value="9170" />
				<param name="next_row" value="9180" />
				<param name="label" value="$LOCALIZE[31707]" />
				<param name="items" value="LeanHomeShortcuts" />
			</include>
		</control>
	</controls>
</window>
