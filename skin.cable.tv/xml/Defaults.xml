<?xml version="1.0" encoding="UTF-8"?>
<!--
	Cable TV control defaults.

	This is the highest-leverage file in the skin. Kodi applies a <default
	type="X"> to every control of that type that does not override the property,
	so restyling here restyles roughly sixty window files we deliberately never
	open - including the PVR windows this user does not use but which must still
	exist and must still look like the rest of the skin.

	Two things to know before editing:

	  * <default> names resolve first-wins via try_emplace, silently. There must
	    be exactly one <default type="button"> in the whole skin. tools/kodilint.py
	    checks this.
	  * Surfaces are all one 9-slice, cable/frames/rounded8.png, tinted per state
	    with colordiffuse. Estuary shipped seven separate button/panel PNGs for
	    what is here a single file plus a colour name, which is also why state
	    changes cost no extra texture memory.

	Focus convention throughout: an accent-filled surface with accent_ink text,
	against surface_raised with text_primary when unfocused. Flat - no gradients,
	no bevels, no drop shadows on text.
-->
<includes>

	<default type="image">
		<texture></texture>
		<aspectratio>stretch</aspectratio>
	</default>

	<default type="multiimage">
		<aspectratio align="center">scale</aspectratio>
		<fadetime>600</fadetime>
		<timeperimage>9000</timeperimage>
		<randomize>true</randomize>
	</default>

	<default type="label">
		<label></label>
		<align>left</align>
		<font>lb_body</font>
		<textcolor>text_primary</textcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<selectedcolor>accent</selectedcolor>
		<!-- Off by default: <autoscroll>/<scroll> marks the layout dirty every
		     frame, which is measurable on a Fire Stick when it is on ~80 list
		     items at once. Enable it per control where it is actually needed. -->
		<scroll>false</scroll>
		<scrollspeed>40</scrollspeed>
	</default>

	<default type="fadelabel">
		<align>left</align>
		<font>lb_body</font>
		<textcolor>text_primary</textcolor>
		<disabledcolor>text_disabled</disabledcolor>
	</default>

	<default type="textbox">
		<align>left</align>
		<font>lb_body</font>
		<textcolor>text_secondary</textcolor>
	</default>

	<default type="button">
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
		<font>lb_button</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>accent_ink</focusedcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<textoffsetx>20</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>no</pulseonselect>
	</default>

	<default type="togglebutton">
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
		<alttexturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</alttexturefocus>
		<alttexturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</alttexturenofocus>
		<font>lb_button</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>accent_ink</focusedcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<textoffsetx>20</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>no</pulseonselect>
	</default>

	<default type="radiobutton">
		<radiowidth>92</radiowidth>
		<radioheight>48</radioheight>
		<textureradioonfocus colordiffuse="accent_ink">cable/controls/switch-on.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="accent">cable/controls/switch-on.png</textureradioonnofocus>
		<textureradioofffocus colordiffuse="accent_ink">cable/controls/switch-off.png</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="text_hint">cable/controls/switch-off.png</textureradiooffnofocus>
		<textureradioondisabled colordiffuse="text_disabled">cable/controls/switch-on.png</textureradioondisabled>
		<textureradiooffdisabled colordiffuse="text_disabled">cable/controls/switch-off.png</textureradiooffdisabled>
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
		<font>lb_button</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>accent_ink</focusedcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<textoffsetx>20</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>no</pulseonselect>
	</default>

	<default type="edit">
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
		<font>lb_body</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>accent_ink</focusedcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<invalidcolor>error</invalidcolor>
		<textoffsetx>20</textoffsetx>
		<aligny>center</aligny>
		<pulseonselect>no</pulseonselect>
	</default>

	<default type="progress">
		<!-- Flat: a tinted 4x4 white pixel stretched. No progress-bar artwork at
		     all, in either state. -->
		<texturebg border="3" colordiffuse="divider">colors/white.png</texturebg>
		<midtexture border="3" colordiffuse="accent">colors/white.png</midtexture>
		<lefttexture></lefttexture>
		<righttexture></righttexture>
		<overlaytexture></overlaytexture>
	</default>

	<default type="scrollbar">
		<texturesliderbackground colordiffuse="divider">colors/white.png</texturesliderbackground>
		<texturesliderbar colordiffuse="text_hint">colors/white.png</texturesliderbar>
		<texturesliderbarfocus colordiffuse="accent">colors/white.png</texturesliderbarfocus>
		<textureslidernib></textureslidernib>
		<textureslidernibfocus></textureslidernibfocus>
		<showonepage>false</showonepage>
		<orientation>vertical</orientation>
	</default>

	<default type="slider">
		<texturesliderbar border="12" colordiffuse="divider">cable/frames/pill.png</texturesliderbar>
		<texturesliderbardisabled border="12" colordiffuse="text_disabled">cable/frames/pill.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="text_primary">cable/masks/circle.png</textureslidernib>
		<textureslidernibfocus colordiffuse="accent">cable/masks/circle.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="text_disabled">cable/masks/circle.png</textureslidernibdisabled>
		<orientation>horizontal</orientation>
	</default>

	<default type="sliderex">
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
		<sliderwidth>200</sliderwidth>
		<sliderheight>24</sliderheight>
		<texturesliderbar border="12" colordiffuse="divider">cable/frames/pill.png</texturesliderbar>
		<texturesliderbardisabled border="12" colordiffuse="text_disabled">cable/frames/pill.png</texturesliderbardisabled>
		<textureslidernib colordiffuse="text_primary">cable/masks/circle.png</textureslidernib>
		<textureslidernibfocus colordiffuse="accent_ink">cable/masks/circle.png</textureslidernibfocus>
		<textureslidernibdisabled colordiffuse="text_disabled">cable/masks/circle.png</textureslidernibdisabled>
		<font>lb_body</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>accent_ink</focusedcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<textoffsetx>20</textoffsetx>
		<aligny>center</aligny>
	</default>

	<default type="spincontrol">
		<textureup colordiffuse="text_secondary">cable/icons/arrow-up.png</textureup>
		<texturedown colordiffuse="text_secondary">cable/icons/arrow-down.png</texturedown>
		<textureupfocus colordiffuse="accent">cable/icons/arrow-up.png</textureupfocus>
		<texturedownfocus colordiffuse="accent">cable/icons/arrow-down.png</texturedownfocus>
		<textureupdisabled colordiffuse="text_disabled">cable/icons/arrow-up.png</textureupdisabled>
		<texturedowndisabled colordiffuse="text_disabled">cable/icons/arrow-down.png</texturedowndisabled>
		<align>right</align>
		<width>84</width>
		<height>36</height>
		<font>lb_bodysm</font>
		<reverse>yes</reverse>
		<textcolor>text_primary</textcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<subtype>text</subtype>
		<textoffsetx>-6</textoffsetx>
		<textoffsety>0</textoffsety>
		<pulseonselect>no</pulseonselect>
	</default>

	<default type="spincontrolex">
		<spinwidth>36</spinwidth>
		<spinheight>60</spinheight>
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
		<textureup colordiffuse="text_secondary">cable/icons/arrow-up.png</textureup>
		<texturedown colordiffuse="text_secondary">cable/icons/arrow-down.png</texturedown>
		<textureupfocus colordiffuse="accent_ink">cable/icons/arrow-up.png</textureupfocus>
		<texturedownfocus colordiffuse="accent_ink">cable/icons/arrow-down.png</texturedownfocus>
		<textureupdisabled colordiffuse="text_disabled">cable/icons/arrow-up.png</textureupdisabled>
		<texturedowndisabled colordiffuse="text_disabled">cable/icons/arrow-down.png</texturedowndisabled>
		<font>lb_button</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>accent_ink</focusedcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<textoffsetx>20</textoffsetx>
		<aligny>center</aligny>
		<reverse>yes</reverse>
		<pulseonselect>no</pulseonselect>
	</default>

	<default type="colorbutton">
		<colorwidth>150</colorwidth>
		<colorheight>60</colorheight>
		<texturecolormask border="16">cable/frames/rounded8.png</texturecolormask>
		<texturecolordisabledmask border="16" colordiffuse="text_disabled">cable/frames/rounded8.png</texturecolordisabledmask>
		<font>lb_button</font>
		<textcolor>text_primary</textcolor>
		<focusedcolor>accent_ink</focusedcolor>
		<disabledcolor>text_disabled</disabledcolor>
		<textoffsetx>20</textoffsetx>
		<align>left</align>
		<aligny>center</aligny>
		<pulseonselect>no</pulseonselect>
	</default>

	<default type="mover">
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
	</default>

	<default type="resize">
		<texturefocus border="16" colordiffuse="accent">cable/frames/rounded8.png</texturefocus>
		<texturenofocus border="16" colordiffuse="surface_raised">cable/frames/rounded8.png</texturenofocus>
	</default>

	<default type="grouplist">
		<itemgap>0</itemgap>
		<align>left</align>
	</default>
</includes>
